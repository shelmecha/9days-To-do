{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/demo", "destination": "/index.html" }
  ]
}
